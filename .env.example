APP_NAME=theta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8790
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# theta compose services (docker compose -p theta); never the perp stack's.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=theta
DB_USERNAME=theta
DB_PASSWORD=theta
DB_ROOT_PASSWORD=theta-root

SESSION_DRIVER=file
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Robinhood agentic MCP — broker/control plane.
HARNESS_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading
# Pinned agentic cash account; never model-selected.
HARNESS_AGENTIC_ACCOUNT=872449178
# approval | auto
HARNESS_MODE=auto
HARNESS_KILL_SWITCH=false
# RH agentic OAuth token (bootstrap fallback; encrypted store is primary). Not in git.
HARNESS_OAUTH_TOKEN=
# Bearer for the read-only telemetry API.
HARNESS_TELEMETRY_TOKEN=

# Bankroll caps (USD debit, settled-cash accounting).
HARNESS_ALLOC_PER_DAY=200
HARNESS_ALLOC_PER_PLAY=50
HARNESS_ALLOC_PER_SYMBOL=50
HARNESS_MAX_OPEN_POSITIONS=8

# Options lane — single-leg Level 2 (approved 2026-06-12).
HARNESS_OPTIONS_ENABLED=true
HARNESS_OPTIONS_MAX_SPREAD_BPS=1500
HARNESS_OPTIONS_MAX_CONTRACT_ASK=5.00
HARNESS_OPTIONS_PER_PLAY_MAX_DEBIT=75.00
HARNESS_OPTIONS_PER_DAY_MAX_DEBIT=250.00
HARNESS_OPTIONS_PER_UNDERLYING_MAX_DEBIT=100.00
HARNESS_OPTIONS_MAX_OPEN_POSITIONS=4
HARNESS_OPTIONS_QUOTE_FRESH_SECONDS=10

# Execution policy + plumbing (defaults match config/harness.php).
HARNESS_MARKETABLE_LIMIT_OFFSET_BPS=10
HARNESS_MAX_SPREAD_BPS=50
HARNESS_GREEKS_BASE_URL=http://greeks:8000
HARNESS_GREEKS_TIMEOUT=130
HARNESS_DATA_STALENESS_SECONDS=10
HARNESS_AGENT_ID=theta-harness
# HARNESS_TELEMETRY_DIR defaults to storage/harness inside the app container.
#HARNESS_TELEMETRY_DIR=

# Data plane — Alpaca Algo Trader Plus / SIP. Secrets not in git.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
ALPACA_DATA_FEED=sip
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/sip
