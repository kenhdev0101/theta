APP_NAME=theta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8790
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# theta compose services (docker compose -p theta); never the perp stack's.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=theta
DB_USERNAME=theta
DB_PASSWORD=theta
DB_ROOT_PASSWORD=theta-root

SESSION_DRIVER=file
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Robinhood agentic MCP — broker/control plane.
HARNESS_MCP_ENDPOINT=https://agent.robinhood.com/mcp/trading
# Pinned agentic cash account; never model-selected.
HARNESS_AGENTIC_ACCOUNT=872449178
# approval | auto
HARNESS_MODE=auto
HARNESS_KILL_SWITCH=false
# RH agentic OAuth token (bootstrap fallback; encrypted store is primary). Not in git.
HARNESS_OAUTH_TOKEN=
# Bearer for the read-only telemetry API.
HARNESS_TELEMETRY_TOKEN=

# Broker API credits — enforced at the Robinhood MCP transport boundary.
HARNESS_BROKER_CREDITS_ENABLED=true
HARNESS_BROKER_CREDITS_PER_MINUTE=45
HARNESS_BROKER_CREDITS_MODE=wait
HARNESS_BROKER_CREDITS_MAX_WAIT_SECONDS=20
HARNESS_BROKER_CREDITS_KEY=theta:robinhood:mcp:credits

# Bankroll caps (USD debit, settled-cash accounting).
HARNESS_ALLOC_PER_DAY=200
HARNESS_ALLOC_PER_PLAY=50
HARNESS_ALLOC_PER_SYMBOL=50
HARNESS_MAX_OPEN_POSITIONS=8

# Options lane — single-leg Level 2 (approved 2026-06-12).
HARNESS_OPTIONS_ENABLED=true
HARNESS_OPTIONS_MAX_SPREAD_BPS=1500
HARNESS_OPTIONS_MAX_CONTRACT_ASK=5.00
HARNESS_OPTIONS_PER_PLAY_MAX_DEBIT=75.00
HARNESS_OPTIONS_PER_DAY_MAX_DEBIT=250.00
HARNESS_OPTIONS_DAILY_GROSS_ENTRY_DEBIT=500.00
HARNESS_OPTIONS_PER_UNDERLYING_MAX_DEBIT=50.00
HARNESS_OPTIONS_MAX_OPEN_POSITIONS=4
HARNESS_OPTIONS_QUOTE_FRESH_SECONDS=10
HARNESS_OPTIONS_METADATA_CACHE_SECONDS=900
HARNESS_OPTIONS_PRODUCER_ENABLED=true
HARNESS_OPTIONS_PRODUCER_UNIVERSE_SOURCE=dynamic
HARNESS_OPTIONS_PRODUCER_SYMBOLS=SPY,QQQ,IWM,DIA,SMH,SOXX,XLF,XLK,XLE,NVDA,AAPL,MSFT,META,AMZN,AMD,TSLA,GOOGL
HARNESS_OPTIONS_PRODUCER_DYNAMIC_MAX_SYMBOLS=6
HARNESS_OPTIONS_PRODUCER_OPTION_TYPE=auto
HARNESS_OPTIONS_PRODUCER_EXPIRATION_MIN_DAYS=1
HARNESS_OPTIONS_PRODUCER_MAX_CHAIN_PAGES=3
HARNESS_OPTIONS_PRODUCER_QUOTE_CHUNK_LIMIT=3
HARNESS_OPTIONS_PRODUCER_BLOCK_COOLDOWN_MINUTES=5
HARNESS_OPTIONS_PRODUCER_ENTRY_SYMBOL_COOLDOWN_MINUTES=10
HARNESS_OPTIONS_PRODUCER_BUYING_POWER_RESERVE_DEBIT=25.00

# Execution policy + plumbing (defaults match config/harness.php).
HARNESS_MARKETABLE_LIMIT_OFFSET_BPS=10
HARNESS_MAX_SPREAD_BPS=50
HARNESS_GREEKS_BASE_URL=http://greeks:8000
HARNESS_GREEKS_TIMEOUT=130
HARNESS_DATA_STALENESS_SECONDS=10
HARNESS_AGENT_ID=theta-harness
# HARNESS_TELEMETRY_DIR defaults to storage/harness inside the app container.
#HARNESS_TELEMETRY_DIR=

# Data plane — Alpaca Algo Trader Plus / SIP. Secrets not in git.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET_KEY=
ALPACA_DATA_FEED=sip
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/sip

# Options producer momentum discovery.
HARNESS_OPTIONS_PRODUCER_MOMENTUM_TIMEFRAME=1Min
HARNESS_OPTIONS_PRODUCER_MOMENTUM_LOOKBACK_BARS=10
HARNESS_OPTIONS_PRODUCER_MOMENTUM_BAR_FRESH_SECONDS=180
HARNESS_OPTIONS_PRODUCER_MOMENTUM_MIN_RETURN_BPS=3.0
HARNESS_OPTIONS_PRODUCER_MOMENTUM_MIN_VOLUME_EXPANSION=0.5
HARNESS_OPTIONS_PRODUCER_UNDERLYING_MAX_SPREAD_BPS=5.0
HARNESS_OPTIONS_PRODUCER_EXIT_ENABLED=true
HARNESS_OPTIONS_PRODUCER_EXIT_PROFIT_TARGET_BPS=1200.0
HARNESS_OPTIONS_PRODUCER_EXIT_STOP_LOSS_BPS=2000.0
HARNESS_OPTIONS_PRODUCER_EXIT_MAX_HOLD_MINUTES=1.0
HARNESS_OPTIONS_PRODUCER_EXIT_MAX_HOLD_MIN_PNL_BPS=1.0
HARNESS_OPTIONS_PRODUCER_ALLOCATION_CAPITAL_LOCK_DAYS=1.0
HARNESS_OPTIONS_PRODUCER_ALLOCATION_MIN_EXPECTED_GAIN=0.0
HARNESS_OPTIONS_PRODUCER_ALLOCATION_EXPECTED_GAIN_MULTIPLIER=1.0
